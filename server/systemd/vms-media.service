# MediaMTX — prod alohida unit (root §4.2: "Prod'da MediaMTX alohida systemd
# unit, vmsd uni boshqarmaydi"). S4'da to'liq tekshiriladi.
# Tuning (root §16.3): /etc/sysctl.d/99-vms.conf: net.core.rmem_max=100000000
[Unit]
Description=Central VMS media server (MediaMTX)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/opt/vmsd/mediamtx/mediamtx /opt/vmsd/mediamtx/mediamtx.yml
Restart=always
RestartSec=3
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
