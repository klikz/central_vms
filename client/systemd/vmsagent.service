[Unit]
Description=Central VMS agent (vmsagent) - joydagi kamera agenti
Documentation=https://example.internal/central_vms/client
After=network-online.target
Wants=network-online.target
# Crash-loop himoyasi (server unitlari bilan bir xil siyosat): 300 s'da
# 20 martadan ko'p qulasa "failed" — operatorga aniq belgi.
StartLimitIntervalSec=300
StartLimitBurst=20

[Service]
Type=simple
ExecStart=/opt/vmsagent/vmsagent -config /etc/vmsagent/client.yaml
EnvironmentFile=-/etc/vmsagent/env

# C4.3: to'liq qotirish (§5, §10.4).
Restart=always
RestartSec=5
TimeoutStopSec=10
NoNewPrivileges=true
LimitNOFILE=8192
# Xotira cheki: FFmpeg bolalari shu cgroup ichida (1G = agent + transcode'lar).
MemoryHigh=768M
MemoryMax=1G

User=vmsagent
Group=vmsagent
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
# Yozish ruxsati faqat shu ikki joyga (state + alohida CLIENT log fayli):
ReadWritePaths=/var/lib/vmsagent /var/log/vmsagent

StandardOutput=journal
StandardError=journal
SyslogIdentifier=vmsagent

[Install]
WantedBy=multi-user.target
