# vmsagent konfiguratsiyasi — to'liq sxema: docs/protocol.md §11
# DIQQAT: quyidagi state_dir/key_file yo'llari production uchun (root huquqi kerak).
# Bu mashinada sinash uchun: `cp config/client.yaml.example config/client.local.yaml`
# va yo'llarni ./var/… ga o'zgartiring (yoki `make run` / `make dev`),
# serverga o'rnatish uchun: `sudo make install`.
# Maxfiy fayllar (agent parollari, agent.key) git'ga kirmaydi (§4.3).

server_url: ws://192.168.1.10:8081      # ws:// yoki wss:// (host:port majburiy)
ui_bind: 127.0.0.1:8082                 # LAN manziliga qo'yilsa agent ogohlantiradi
ui_pin: ""                              # BEKOR qilindi (1.0-draft.10) — o'qiladi, ishlatilmaydi
client_name: ""                       # serverda ko‘rinadigan nom (masalan: Oxangaron)
state_dir: /var/lib/vmsagent
key_file: /etc/vmsagent/agent.key
log_level: info                         # debug|info|warn|error
log_file: /var/log/vmsagent/vmsagent.log  # CLIENT logi (alohida; serverniki vmsd o'z faylida)
log_max_mb: 4                           # hajm chegarasi — oshsa rotatsiya
log_keep: 5                             # .1…N eski fayllar soni (disk to'lmaydi)

probe:
  status_parallel: 5                    # pacing: bir vaqtda nechta probe (§16.4)
  status_keepalive: auto                # auto|get_parameter|options|describe (§12.1)
  codec_probe_interval_h: 24            # to'liq kodek probe oralig'i (§12.3)
  full_probe_on_publish_fail: true      # publish xatosida darhol qayta probe (§12.3)

limits:
  # Hikvision/Dahua kameraning O'ZIDA sessiya limiti bor (odatda 4):
  # bitta kamera uchun main+sub publish + probe birga 2-3 sessiya qiladi.
  # Shuning uchun prod'da 4 tavsiya etiladi (8 emas): ko'p kamera bir
  # vaqtda tortilsa ham kamera sessiyalari chegarada qoladi (cams.Gate
  # band kamerani proberlamaydi — §8.3b; 2026-11-22 izohi).
  max_uploads: 4                        # server config_push bilan yangilanadi (§5.7)
  max_local_transcodes: 4               # GPU bo'lsa 8, CPU-only 4 (§10.4)

onvif:
  enabled: true                         # ixtiyoriy modul (Dahua RTSP-only ishlashi mumkin)
  switch_codec: true                    # SetVideoEncoderConfiguration urinishi (§8.1-3)

discovery:
  cidrs: ["192.168.10.0/24"]            # rtsp_scan uchun; /22 dan keng rad etiladi (§16.4)
  onvif_timeout_s: 10
  rtsp_scan_ports: [554]
  max_hosts: 1024

publish:
  whip_fallback: rtsp_tcp               # WHIP UDP ishlamasa (§8.1)
  ffmpeg_fallback: true                 # Go yo'li interop xatosida (§8.1)
